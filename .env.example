# Copia este archivo como .env.local y pon tu clave de Gemini (https://aistudio.google.com/apikey).
# Solo la lee el servidor de Vite (server/agentProxy.ts): no lleva prefijo VITE_, asi que nunca
# llega al navegador.
GEMINI_API_KEY=

# Opcional: modelo del agente (por defecto gemini-3.8-flash).
# NEUMACARE_MODEL=gemini-3.8-flash

# Opcional: modelos de respaldo, en orden, si el principal esta saturado (503) o sin cuota.
# NEUMACARE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
